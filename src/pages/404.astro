---
import Layout from '../layouts/Layout.astro';
import SectionContainer from '../components/layout/SectionContainer.astro';
import Button from '../assets/buttons/Button.astro';
---

<Layout
	title="Página no encontrada | Salem Martínez"
	description="La página que buscas no existe."
	noindex>
	<main
		id="contenido-principal"
		tabindex="-1"
		class="flex items-center pt-20 focus:outline-none">
		<SectionContainer class="flex flex-col items-start gap-6 py-24">
			<p class="text-lg font-semibold text-cyan-500">Error 404</p>
			<h1 class="text-3xl font-bold text-foreground md:text-5xl">
				Esta página no existe
			</h1>
			<p class="max-w-[70ch] text-foreground leading-8">
				Es posible que el enlace esté roto o que la página haya cambiado de
				lugar.
			</p>
			<Button href="/" variant="email">Volver al inicio</Button>
		</SectionContainer>
	</main>
</Layout>
