---
// Layout.
import Layout from '../layouts/Layout.astro';

// Componentes.
import Hero from '../components/hero/Hero.astro';
import ContentSection from '../components/layout/ContentSection.astro';
import AboutMe from '../components/about/AboutMe.astro';
import Projects from '../components/projects/Projects.astro';
import Contact from '../components/contact/Contact.astro';

// Iconos.
import ProfileIcon from '../assets/icons/Profile.astro';
import BriefcaseIcon from '../assets/icons/Briefcase.astro';
import MailIcon from '../assets/icons/Mail.astro';

/*
 * Página principal del portafolio.
 * Organiza las diferentes secciones del sitio dentro del layout
 * principal, manteniendo una estructura clara y semántica.
 */

/*
 * Estilos del contenedor principal de la página.
 */
const mainClass = `
	pt-20
`;

/*
 * Estilos de la sección Hero.
 * Ocupa prácticamente toda la altura de la ventana y centra
 * verticalmente su contenido.
 */
const heroSectionClass = `
	flex
	min-h-[calc(100svh-5rem)]
	items-center
	pt-10
	lg:pt-0
`;

/*
 * Espaciado vertical entre las secciones del portafolio.
 */
const sectionsContainerClass = `
	space-y-24
	md:space-y-32
`;
---

<Layout
	title="Salem Martínez | Desarrollador Web PHP/Laravel"
	description="Ingeniero de Sistemas y Desarrollador Web. Creo soluciones web orientadas a optimizar procesos empresariales.">
	<main id="contenido-principal" class={mainClass}>
		<ContentSection id="inicio" class={heroSectionClass}>
			<Hero />
		</ContentSection>

		<div class={sectionsContainerClass}>
			<ContentSection id="acerca-de-mi" title="Acerca de Mí" icon={ProfileIcon}>
				<AboutMe />
			</ContentSection>

			<ContentSection id="proyectos" title="Proyectos" icon={BriefcaseIcon}>
				<Projects />
			</ContentSection>

			<ContentSection id="contacto" title="Contacto" icon={MailIcon}>
				<Contact />
			</ContentSection>
		</div>
	</main>
</Layout>
