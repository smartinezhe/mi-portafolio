---
/*
 * Componente reutilizable para renderizar enlaces con apariencia de botón.
 * Se utiliza para acciones principales de contacto, ya sean enlaces externos
 * (como WhatsApp o GitHub) o internos (como una sección de la misma página),
 * manteniendo una apariencia y comportamiento consistente. El comportamiento
 * de navegación (`target`, `rel`) se define por quien consume el componente,
 * según corresponda al tipo de enlace.
 */

/*
 * Propiedades del componente.
 * Permite recibir clases adicionales y cualquier atributo válido de un enlace.
 */
interface Props extends astroHTML.JSX.AnchorHTMLAttributes {
	class?: string;
}

/*
 * Obtiene las propiedades del componente.
 */
const {class: className = '', ...props}: Props = Astro.props;

/*
 * Estilos base compartidos por todos los botones de acción.
 */
const baseButtonClass = `
	flex
	items-center
	justify-center
	gap-x-2
	rounded-xl
	px-3
	py-2
	transition-colors
	duration-200
	ease-out
	focus:outline-none
	focus-visible:ring-2
	focus-visible:ring-offset-2
	focus-visible:ring-offset-[#191b21]
`;
---

<a class={`${baseButtonClass} ${className}`} role="link" {...props}>
	<slot />
</a>
