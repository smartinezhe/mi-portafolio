---
/*
 * Componente reutilizable para renderizar enlaces con apariencia de botón.
 * Aplica el estilo "3D solid push": una cara de color con un borde sólido
 * inferior que se comprime al interactuar. El color se elige con la prop
 * `variant`, que también define el tono del borde mediante `--btn-edge`.
 */

// Tipos.
import type {HTMLAttributes} from 'astro/types';

type Variant = 'slate' | 'email' | 'linkedin';

interface Props extends HTMLAttributes<'a'> {
	variant?: Variant;
	class?: string;
}

const {variant = 'slate', class: className = '', ...props}: Props = Astro.props;

/*
 * Estilos base compartidos por todos los botones.
 * - Normal: borde inferior de 6px.
 * - Hover: el botón baja 2px y el borde se reduce a 4px.
 * - Active: el botón baja 6px y el borde desaparece (queda "presionado").
 * La base visual del botón no se mueve en ningún estado.
 */
const baseButtonClass = `
	inline-flex
	items-center
	justify-center
	gap-x-2
	rounded-xl
	px-3
	py-2
	font-semibold
	translate-y-0
	shadow-[0_6px_0_0_var(--btn-edge)]
	transition-[translate,box-shadow]
	duration-100
	ease-out
	hover:translate-y-0.5
	hover:shadow-[0_4px_0_0_var(--btn-edge)]
	active:translate-y-1.5
	active:shadow-[0_0_0_0_var(--btn-edge)]
	motion-reduce:transition-none
	focus:outline-none
	focus-visible:ring-2
	focus-visible:ring-offset-2
	focus-visible:ring-offset-background
`;

/*
 * Variantes de color: cara, texto, borde sólido y anillo de foco.
 */
const variants: Record<Variant, string> = {
	email: `
		bg-amber-400
		text-black
		[--btn-edge:var(--color-amber-600)]
		focus-visible:ring-amber-300
	`,
	linkedin: `
		bg-sky-700
		text-white
		[--btn-edge:var(--color-sky-900)]
		focus-visible:ring-sky-400
	`,
	slate: `
		bg-slate-300
		text-black
		[--btn-edge:var(--color-slate-500)]
		focus-visible:ring-slate-300
	`,
};

/*
 * Los enlaces que abren pestaña nueva lo anuncian a lectores de pantalla.
 */
const opensInNewTab = props.target === '_blank';
---

<a class={`${baseButtonClass} ${variants[variant]} ${className}`} {...props}>
	<slot />
	{opensInNewTab && <span class="sr-only">(se abre en una pestaña nueva)</span>}
</a>
