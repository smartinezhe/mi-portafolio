---
// Estilos globales.
import '../styles/global.css';

// Componentes.
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

/*
 * Componente base del portafolio.
 * Define la estructura HTML compartida por todas las páginas,
 * incluyendo la configuración SEO, el encabezado y el pie de página.
 */

/*
 * Propiedades necesarias para configurar los metadatos de la página.
 */
interface Props {
	title: string;
	description: string;
}

/*
 * Obtiene las propiedades utilizadas para construir
 * el título y la descripción del documento.
 */
const {title, description}: Props = Astro.props;

/*
 * URLs absolutas utilizadas por las etiquetas SEO y Open Graph.
 */
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageURL = new URL('/og-image.png', Astro.site).toString();
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#111827" />
		<meta name="robots" content="index, follow" />

		<link rel="canonical" href={canonicalURL} />

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="628" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
	</head>

	<body>
		<Header />
		<slot />
		<Footer />
	</body>
</html>
