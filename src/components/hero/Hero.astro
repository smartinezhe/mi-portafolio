---
// Iconos.
import WhatsAppIcon from '../../assets/icons/WhatsApp.astro';

// Ilustraciones.
import HeroIllustration from '../../assets/illustration/HeroIllustration.astro';

// Componentes.
import ContactButton from '../../assets/buttons/ContactButton.astro';

/*
 * Componente principal de presentación (Hero).
 * Muestra el nombre, la descripción profesional, el enlace
 * de contacto y la ilustración principal del portafolio.
 */

/*
 * Número de WhatsApp utilizado para generar el enlace de contacto.
 */
const whatsappNumber = '573125815262';

/*
 * URL completa para abrir una conversación en WhatsApp.
 */
const whatsappUrl = `https://wa.me/${whatsappNumber}`;

/*
 * Estilos específicos del botón contacto.
 */
const contactButtonClass = `
    min-w-35
	justify-center
	font-semibold
	shadow-sm
	shadow-black/30
	bg-emerald-400
	border border-emerald-500
	text-black
	hover:bg-emerald-500
	focus-visible:ring-emerald-500/50
`;

/*
 * Estilos del contenedor principal del Hero.
 */
const heroClass = `
	flex
	flex-col
	gap-16
	lg:flex-row
	lg:items-center
	lg:justify-between
`;

/*
 * Contenedor del contenido textual.
 */
const heroContentClass = `
	flex
	max-w-2xl
	flex-col
	gap-6
`;

/*
 * Estilos del título principal.
 */
const heroTitleClass = `
	text-3xl
	font-bold
	text-white
	md:text-4xl
	lg:text-5xl
`;

/*
 * Estilos de la descripción principal.
 */
const heroDescriptionClass = `
	max-w-xl
	text-xl
	text-gray-200
	opacity-80
	lg:text-2xl
`;

/*
 * Contenedor de los botones de contacto.
 */
const heroActionsClass = `
	flex
	flex-wrap
	gap-4
`;

/*
 * Contenedor de la ilustración principal.
 */
const illustrationContainerClass = `
	flex
	justify-center
	lg:flex-1
`;

/*
 * Estilos de la ilustración principal.
 */
const illustrationClass = `
	w-full
	max-w-sm
	md:max-w-md
	lg:max-w-xl
`;
---

<div class={heroClass}>
	<div class={heroContentClass}>
		<h1 class={heroTitleClass}>Salem Martínez</h1>

		<h2 class={heroDescriptionClass}>
			Convierto ideas en aplicaciones web que optimizan procesos empresariales.
		</h2>

		<div class={heroActionsClass}>
			<ContactButton
				href={whatsappUrl}
				target="_blank"
				rel="noopener noreferrer"
				class={contactButtonClass}>
				<WhatsAppIcon class="size-5" />
				Hablemos de tu proyecto
			</ContactButton>
		</div>
	</div>

	<div class={illustrationContainerClass}>
		<HeroIllustration class={illustrationClass} />
	</div>
</div>
