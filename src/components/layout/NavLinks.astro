---
/*
 * Renderiza los elementos de una lista de navegación. Se reutiliza en el
 * menú de escritorio y en el móvil con distintos estilos. `data-section`
 * enlaza cada enlace con su sección para el resaltado de sección activa.
 */
interface NavLink {
	title: string;
	label: string;
	url: string;
}

interface Props {
	items: NavLink[];
	linkClassName?: string;
}

const {items, linkClassName = ''}: Props = Astro.props;
---

{
	items.map((link) => (
		<li>
			<a href={link.url} class={linkClassName} data-section={link.label}>
				{link.title}
			</a>
		</li>
	))
}
