---
// Componentes.
import Logo from '../../assets/logo/Logo.astro';
import MenuIcon from '../../assets/icons/MenuIcon.astro';
import CloseIcon from '../../assets/icons/CloseIcon.astro';
import NavLinks from './NavLinks.astro';

/*
 * Encabezado principal del portafolio: logotipo, navegación de escritorio
 * y menú móvil con su lógica de apertura, cierre y sección activa.
 */

/*
 * `label` es el id de la sección. Las URLs empiezan con `/` para que los
 * enlaces también funcionen desde otras páginas (por ejemplo, la 404).
 */
const navItems = [
	{title: 'Acerca de Mí', label: 'acerca-de-mi', url: '/#acerca-de-mi'},
	{title: 'Proyectos', label: 'proyectos', url: '/#proyectos'},
	{title: 'Contacto', label: 'contacto', url: '/#contacto'},
];

const glassPanelClass = `
	rounded-3xl
	border border-white/15
	bg-linear-to-br from-white/15 via-white/5 to-white/10
	backdrop-blur-2xl backdrop-saturate-150
	shadow-[inset_0_1px_0_0_rgba(255,255,255,0.35),inset_0_-1px_0_0_rgba(255,255,255,0.06),0_8px_32px_rgba(0,0,0,0.4)]
`;

const navigationTextClass = `
	text-sm
	font-medium
	text-foreground
`;

/*
 * Estado del enlace de la sección visible (aria-current="location").
 * Fondo más tenue que el hover (bg-white/15) y subrayado en cian,
 * para que ambos estados se distingan.
 */
const activeLinkClass = `
	aria-[current=location]:bg-white/10
	aria-[current=location]:text-cyan-300
	aria-[current=location]:underline
	aria-[current=location]:decoration-cyan-300/70
	aria-[current=location]:decoration-2
	aria-[current=location]:underline-offset-8
`;

const desktopLinkClass = `
	flex items-center justify-center
	px-3 sm:px-4 py-2
	rounded-lg
	whitespace-nowrap
	transition-colors duration-200 ease-out
	hover:bg-white/15
	hover:text-cyan-300
	motion-reduce:transition-none
	focus:outline-none
	focus-visible:ring-2
	focus-visible:ring-sky-300
	${activeLinkClass}
`;

const mobileLinkClass = `
	flex items-center justify-center
	px-4 py-3
	rounded-xl
	transition-colors duration-200 ease-out
	hover:bg-white/15
	hover:text-cyan-300
	motion-reduce:transition-none
	focus:outline-none
	focus-visible:ring-2
	focus-visible:ring-sky-300
	${activeLinkClass}
`;

const menuButtonClass = `
	flex
	items-center
	justify-center
	size-10
	rounded-xl
	border border-white/25
	bg-white/10
	text-white
	shadow-[inset_0_1px_0_0_rgba(255,255,255,0.25)]
	transition-colors
	duration-200
	hover:bg-white/20
	active:bg-white/25
	motion-reduce:transition-none
	focus:outline-none
	focus-visible:ring-2
	focus-visible:ring-sky-300
	sm:hidden
`;
---

<header id="site-header" class="pointer-events-none fixed inset-x-0 top-4 z-10">
	<div class="mx-auto flex w-full max-w-5xl flex-col px-4">
		<nav
			id="site-navigation"
			aria-label="Principal"
			class={`pointer-events-auto w-full px-4 py-2 sm:px-6 lg:max-w-xl lg:self-center ${glassPanelClass} ${navigationTextClass}`}>
			<div class="flex w-full items-center justify-between">
				<a href="/#inicio" aria-label="Ir al inicio" class="flex items-center">
					<Logo class="size-12" />
				</a>

				<ul
					role="list"
					class="hidden items-center sm:flex sm:gap-1 md:gap-2 lg:gap-3">
					<NavLinks items={navItems} linkClassName={desktopLinkClass} />
				</ul>

				<button
					id="menu-button"
					type="button"
					aria-label="Abrir menú de navegación"
					aria-controls="mobile-menu"
					aria-expanded="false"
					class={menuButtonClass}>
					<span class="relative flex size-6 items-center justify-center">
						<MenuIcon
							id="menu-icon"
							class="absolute size-6 scale-100 opacity-100 transition-all duration-300 motion-reduce:transition-none"
						/>
						<CloseIcon
							id="close-icon"
							class="absolute size-6 scale-75 opacity-0 transition-all duration-300 motion-reduce:transition-none"
						/>
					</span>
				</button>
			</div>
		</nav>

		<nav
			id="mobile-menu"
			aria-label="Menú móvil"
			inert
			class={`pointer-events-none mt-2 w-full -translate-y-2 p-2 opacity-0 transition-all duration-300 ease-out motion-reduce:transition-none sm:hidden ${glassPanelClass} ${navigationTextClass}`}>
			<ul role="list" class="flex flex-col gap-1">
				<NavLinks items={navItems} linkClassName={mobileLinkClass} />
			</ul>
		</nav>
	</div>
</header>

<script>
	/*
	 * Referencias a los elementos del menú móvil. Se tipan explícitamente
	 * y admiten `null` por si algún elemento no existe en la página.
	 */
	const button = document.getElementById(
		'menu-button'
	) as HTMLButtonElement | null;
	const menu = document.getElementById('mobile-menu') as HTMLElement | null;
	const header = document.getElementById('site-header') as HTMLElement | null;
	const menuIcon = document.getElementById('menu-icon');
	const closeIcon = document.getElementById('close-icon');

	/*
	 * Lógica del menú móvil. Solo se ejecuta si existen los tres
	 * elementos principales; los iconos son opcionales.
	 */
	if (button && menu && header) {
		/*
		 * Única función que cambia el estado del menú. `aria-expanded`
		 * es la fuente de verdad; las clases y `inert` se derivan de él.
		 */
		const setMenu = (open: boolean) => {
			// Panel: visibilidad, posición y si recibe clics.
			menu.classList.toggle('opacity-100', open);
			menu.classList.toggle('translate-y-0', open);
			menu.classList.toggle('pointer-events-auto', open);
			menu.classList.toggle('opacity-0', !open);
			menu.classList.toggle('-translate-y-2', !open);
			menu.classList.toggle('pointer-events-none', !open);

			// `inert` saca el panel cerrado del orden de tabulación y de
			// los lectores de pantalla.
			menu.toggleAttribute('inert', !open);

			// Botón: estado y etiqueta accesible según el estado actual.
			button.setAttribute('aria-expanded', String(open));
			button.setAttribute(
				'aria-label',
				open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación'
			);

			// Icono de hamburguesa: visible solo con el menú cerrado.
			menuIcon?.classList.toggle('opacity-0', open);
			menuIcon?.classList.toggle('scale-75', open);
			menuIcon?.classList.toggle('opacity-100', !open);
			menuIcon?.classList.toggle('scale-100', !open);

			// Icono de cierre: visible solo con el menú abierto.
			closeIcon?.classList.toggle('opacity-100', open);
			closeIcon?.classList.toggle('scale-100', open);
			closeIcon?.classList.toggle('opacity-0', !open);
			closeIcon?.classList.toggle('scale-75', !open);
		};

		/*
		 * Indica si el menú está abierto, leyendo `aria-expanded`.
		 */
		const isOpen = () => button.getAttribute('aria-expanded') === 'true';

		/*
		 * Abre o cierra el menú al pulsar el botón.
		 */
		button.addEventListener('click', () => setMenu(!isOpen()));

		/*
		 * Cierra el menú al seleccionar un enlace.
		 */
		menu.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setMenu(false));
		});

		/*
		 * Cierra el menú al hacer clic fuera del encabezado.
		 */
		document.addEventListener('click', (event) => {
			if (isOpen() && !header.contains(event.target as Node)) setMenu(false);
		});

		/*
		 * Cierra el menú con Escape y devuelve el foco al botón,
		 * para que quien navega con teclado no pierda su posición.
		 */
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && isOpen()) {
				setMenu(false);
				button.focus();
			}
		});

		/*
		 * Cierra el menú si la pantalla pasa al breakpoint `sm` (40rem),
		 * donde el menú móvil se oculta, para no dejar `aria-expanded`
		 * en un estado obsoleto.
		 */
		window
			.matchMedia('(min-width: 40rem)')
			.addEventListener('change', (event) => {
				if (event.matches) setMenu(false);
			});
	}

	/*
	 * Sección activa: marca con aria-current="location" el enlace de la
	 * sección que cruza una franja a ~35% de la altura de la ventana.
	 * 'inicio' se observa para quitar el resaltado cuando se vuelve al Hero.
	 */

	// Enlaces de navegación (escritorio y móvil) que apuntan a una sección.
	const links = document.querySelectorAll<HTMLAnchorElement>('a[data-section]');

	// Ids de sección sin repetir (cada sección tiene un enlace en cada menú).
	const ids = [
		...new Set(Array.from(links, (link) => link.dataset.section ?? '')),
	].filter(Boolean);

	/*
	 * Marca como activo el enlace de la sección indicada y desmarca los
	 * demás. Con `null` no queda ninguno activo.
	 */
	const setActive = (id: string | null) => {
		links.forEach((link) => {
			if (link.dataset.section === id)
				link.setAttribute('aria-current', 'location');
			else link.removeAttribute('aria-current');
		});
	};

	if (ids.length > 0) {
		// Elementos de las secciones a observar, ignorando ids inexistentes.
		const observed = ['inicio', ...ids]
			.map((id) => document.getElementById(id))
			.filter((el): el is HTMLElement => el !== null);

		/*
		 * `rootMargin` reduce la zona de detección a una franja entre el
		 * 35% y el 40% de la altura de la ventana. La sección que cruza
		 * esa franja es la activa; en el Hero no se resalta ningún enlace.
		 */
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						setActive(entry.target.id === 'inicio' ? null : entry.target.id);
					}
				}
			},
			{rootMargin: '-35% 0px -60% 0px'}
		);

		observed.forEach((section) => observer.observe(section));

		/*
		 * La última sección es corta y nunca llega a la franja central:
		 * al llegar al final de la página se marca manualmente.
		 */
		window.addEventListener(
			'scroll',
			() => {
				const atBottom =
					window.innerHeight + window.scrollY >=
					document.documentElement.scrollHeight - 2;
				if (atBottom) setActive(ids[ids.length - 1] ?? null);
			},
			{passive: true}
		);
	}
</script>
