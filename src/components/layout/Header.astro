---
// Componentes.
import Logo from '../../assets/logo/Logo.astro';
import MenuIcon from '../../assets/icons/MenuIcon.astro';
import CloseIcon from '../../assets/icons/CloseIcon.astro';
import NavLinks from './NavLinks.astro';

/*
 * Componente encargado de renderizar el encabezado principal del portafolio.
 * Incluye el logotipo, la navegación principal y el menú adaptado para
 * dispositivos móviles, junto con la lógica necesaria para controlar
 * su apertura y cierre.
 */

/*
 * Enlaces que conforman la navegación principal del sitio.
 */
const navItems = [
	{
		title: 'Acerca de Mí',
		label: 'acerca-de-mi',
		url: '#acerca-de-mi',
	},
	{
		title: 'Proyectos',
		label: 'proyectos',
		url: '#proyectos',
	},
	{
		title: 'Tecnologías',
		label: 'tecnologias',
		url: '#tecnologias',
	},
];

/*
 * Estilos del panel principal de navegación.
 */
const navigationPanelClass = `
	rounded-3xl
	border border-white/20
	ring-1 ring-white/10
	bg-linear-to-r from-gray-800/60 to-gray-700/50
	backdrop-blur-xl backdrop-saturate-150
	shadow-lg shadow-black/30
`;

/*
 * Estilos tipográficos compartidos por la navegación.
 */
const navigationTextClass = `
	text-sm
	font-medium
	text-gray-200
`;

/*
 * Estilos de los enlaces del menú en escritorio.
 */
const desktopLinkClass = `
	flex items-center justify-center
	px-3 sm:px-4 py-2
	rounded-lg
	whitespace-nowrap
	transition-all duration-200 ease-out
	hover:bg-white/10
	hover:text-white
	hover:scale-105
	hover:shadow-md hover:shadow-blue-500/20
	active:bg-blue-500/25
	active:scale-[0.98]
	focus:outline-none
	focus-visible:ring-2
	focus-visible:ring-blue-400/50
`;

/*
 * Estilos de los enlaces del menú móvil.
 */
const mobileLinkClass = `
	flex items-center justify-center
	px-4 py-2
	rounded-lg
	transition-all duration-200 ease-out
	hover:bg-white/10
	hover:text-white
	hover:scale-105
	active:bg-blue-500/25
	active:scale-[0.98]
`;

/*
 * Estilos del botón que abre y cierra el menú móvil.
 */
const menuButtonClass = `
	flex
	items-center
	justify-center
	size-10
	rounded-lg
	text-gray-200
	transition-colors
	duration-200
	hover:bg-white/10
	hover:text-white
	focus-visible:outline-none
	focus-visible:ring-2
	focus-visible:ring-blue-400/50
	sm:hidden
`;
---

<header
	id="site-header"
	class="fixed top-4 z-10 flex w-full flex-col items-center">
	<nav
		id="site-navigation"
		class={`flex flex-col w-full max-w-xs sm:max-w-xl px-4 sm:px-6 py-2 ${navigationPanelClass} ${navigationTextClass}`}>
		<div class="flex items-center justify-between w-full">
			<!-- Logo -->
			<a href="#inicio" aria-label="Ir al inicio" class="flex items-center">
				<Logo class="size-12" />
			</a>

			<!-- Menú desktop -->
			<div class="hidden items-center sm:flex">
				<NavLinks items={navItems} linkClassName={desktopLinkClass} />
			</div>

			<!-- Botón del menú -->
			<button
				id="menu-button"
				type="button"
				aria-label="Abrir menú de navegación"
				aria-controls="mobile-menu"
				aria-expanded="false"
				class={menuButtonClass}>
				<span class="relative flex size-6 items-center justify-center">
					<MenuIcon
						id="menu-icon"
						class="absolute size-6 scale-100 opacity-100 transition-all duration-300"
					/>

					<CloseIcon
						id="close-icon"
						class="absolute size-6 scale-75 opacity-0 transition-all duration-300"
					/>
				</span>
			</button>
		</div>
	</nav>

	<!-- Menú móvil -->
	<div
		id="mobile-menu"
		class={`flex w-full max-w-xs flex-col mt-2 gap-2 transition-all duration-300 ease-out opacity-0 -translate-y-2 pointer-events-none ${navigationPanelClass} ${navigationTextClass} sm:hidden`}>
		<NavLinks items={navItems} linkClassName={mobileLinkClass} />
	</div>
</header>

<script>
	/*
	 * Referencias a los elementos que controlan el menú de navegación móvil.
	 * Se tipan explícitamente para aprovechar el autocompletado y las
	 * comprobaciones de tipos que ofrece TypeScript.
	 */
	const button = document.getElementById(
		'menu-button'
	) as HTMLButtonElement | null;

	const menu = document.getElementById('mobile-menu') as HTMLDivElement | null;

	const header = document.getElementById('site-header') as HTMLElement | null;

	const menuIcon = document.getElementById('menu-icon') as SVGElement | null;

	const closeIcon = document.getElementById('close-icon') as SVGElement | null;

	/*
	 * Obtiene todos los enlaces del menú móvil para cerrar
	 * automáticamente el panel cuando el usuario selecciona
	 * una opción de navegación.
	 */
	const mobileLinks =
		document.querySelectorAll<HTMLAnchorElement>('#mobile-menu a');

	/*
	 * Muestra el menú móvil y actualiza el atributo `aria-expanded`
	 * para reflejar correctamente el estado del botón.
	 */
	const openMenu = () => {
		menu?.classList.remove(
			'opacity-0',
			'-translate-y-2',
			'pointer-events-none'
		);

		menu?.classList.add('opacity-100', 'translate-y-0');

		button?.setAttribute('aria-expanded', 'true');

		menuIcon?.classList.add('opacity-0', 'scale-75');
		menuIcon?.classList.remove('opacity-100', 'scale-100');

		closeIcon?.classList.remove('opacity-0', 'scale-75');
		closeIcon?.classList.add('opacity-100', 'scale-100');
	};

	/*
	 * Oculta el menú móvil y actualiza el atributo `aria-expanded`
	 * para indicar que el panel se encuentra cerrado.
	 */
	const closeMenu = () => {
		menu?.classList.remove('opacity-100', 'translate-y-0');

		menu?.classList.add('opacity-0', '-translate-y-2', 'pointer-events-none');

		button?.setAttribute('aria-expanded', 'false');

		menuIcon?.classList.remove('opacity-0', 'scale-75');
		menuIcon?.classList.add('opacity-100', 'scale-100');

		closeIcon?.classList.remove('opacity-100', 'scale-100');
		closeIcon?.classList.add('opacity-0', 'scale-75');
	};

	/*
	 * Alterna el estado del menú móvil dependiendo de si
	 * actualmente se encuentra abierto o cerrado.
	 */
	const toggleMenu = () => {
		menu?.classList.contains('opacity-0') ? openMenu() : closeMenu();
	};

	/*
	 * Abre o cierra el menú cuando el usuario pulsa
	 * el botón de navegación en dispositivos móviles.
	 */
	button?.addEventListener('click', toggleMenu);

	/*
	 * Cierra el menú automáticamente después de seleccionar
	 * una opción de navegación.
	 */
	mobileLinks.forEach((link) => {
		link.addEventListener('click', closeMenu);
	});

	/*
	 * Cierra el menú cuando el usuario hace clic
	 * fuera del encabezado.
	 */
	document.addEventListener('click', (event) => {
		const target = event.target as Node;

		if (!header?.contains(target)) {
			closeMenu();
		}
	});
</script>
