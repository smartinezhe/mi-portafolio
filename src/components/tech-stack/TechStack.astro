---
// Componentes.
import TechIcon from './TechIcon.astro';

// Iconos.
import HTML5 from '../../assets/icons/Html5.astro';
import CSS3 from '../../assets/icons/Css3.astro';
import JavaScript from '../../assets/icons/Javascript.astro';
import Tailwind from '../../assets/icons/Tailwind.astro';
import PHP from '../../assets/icons/Php.astro';
import MySQL from '../../assets/icons/Mysql.astro';
import Laravel from '../../assets/icons/Laravel.astro';
import Filament from '../../assets/icons/Filament.astro';

/*
 * Componente encargado de renderizar las tecnologías que utilizo
 * en el desarrollo de aplicaciones web. Presenta una breve
 * descripción y un listado de tecnologías representadas mediante
 * iconos.
 */

/*
 * Representa una tecnología utilizada en el portafolio.
 */
interface Tech {
	name: string;
	color: string;
	icon: typeof Laravel;
}

/*
 * Tecnologías que forman parte de mi stack de desarrollo.
 */
const techs: Tech[] = [
	{name: 'HTML5', icon: HTML5, color: '#FB490B'},
	{name: 'CSS3', icon: CSS3, color: '#663399'},
	{name: 'JavaScript', icon: JavaScript, color: '#F0DB4F'},
	{name: 'Tailwind', icon: Tailwind, color: '#38BDF8'},
	{name: 'PHP', icon: PHP, color: '#1E88E5'},
	{name: 'MySQL', icon: MySQL, color: '#00618A'},
	{name: 'Laravel', icon: Laravel, color: '#FF2D20'},
	{name: 'Filament', icon: Filament, color: '#EFAF5D'},
];

/*
 * Estilos del párrafo descriptivo.
 */
const descriptionClass = `
	max-w-4xl
	text-gray-200
	leading-8
	opacity-80
`;

/*
 * Contenedor de las tecnologías.
 */
const techListClass = `
	flex
	flex-wrap
	justify-center
	gap-4
`;
---

<div class="flex flex-col gap-8">
	<p class={descriptionClass}>
		En mis proyectos utilizo tecnologías orientadas al desarrollo web moderno,
		combinando herramientas de frontend y backend para crear aplicaciones
		rápidas, mantenibles y con una experiencia de usuario cuidada.
	</p>

	<div class={techListClass}>
		{
			techs.map((tech) => (
				<TechIcon icon={tech.icon} name={tech.name} color={tech.color} />
			))
		}
	</div>
</div>
