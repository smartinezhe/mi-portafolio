---
const navItems = [
	{
		title: 'Inicio',
		label: 'inicio',
		url: '#inicio',
	},
	{
		title: 'Sobre mi',
		label: 'sobre-mi',
		url: '#sobre-mi',
	},
	{
		title: 'Proyectos',
		label: 'proyectos',
		url: '#proyectos',
	},
	{
		title: 'Tecnologías',
		label: 'tecnologias',
		url: '#stack-tecnologico',
	},
];
---

<header class="fixed top-4 z-10 w-full flex justify-center">
	<nav
		class="backdrop-blur-xl backdrop-saturate-150
		bg-linear-to-r from-gray-800/60 to-gray-700/50
		border border-white/20
		shadow-lg shadow-black/30
		ring-1 ring-white/10
		rounded-3xl px-4 sm:px-6 py-2
		w-full max-w-xs sm:max-w-md
		text-gray-200 text-sm font-medium">
		<!-- Botón móvil -->
		<button
			id="menu-button"
			class="sm:hidden flex w-full items-center justify-center px-4 py-2 rounded-lg
			transition-all duration-200 hover:bg-blue-500/15">
			Menú
		</button>

		<!-- Menú desktop -->
		<div id="desktop-menu" class="hidden sm:flex justify-center items-center">
			{
				navItems.map((link) => (
					<a
						class="flex items-center justify-center px-3 sm:px-4 py-2 rounded-lg
						whitespace-nowrap
						transition-all duration-200 ease-out
						hover:bg-blue-500/15
						hover:shadow-md hover:shadow-blue-500/20
						active:bg-blue-500/25
						focus:outline-none
						focus-visible:ring-2
						focus-visible:ring-blue-400/50"
						aria-label={link.label}
						href={link.url}>
						{link.title}
					</a>
				))
			}
		</div>

		<!-- Menú móvil desplegable -->
		<div id="mobile-menu" class="hidden sm:hidden flex-col gap-2 mt-2">
			{
				navItems.map((link) => (
					<a
						class="flex items-center justify-center px-4 py-2 rounded-lg
						transition-all duration-200
						hover:bg-blue-500/15"
						aria-label={link.label}
						href={link.url}>
						{link.title}
					</a>
				))
			}
		</div>
	</nav>
</header>

<script>
	// Referencias a los elementos principales del menú móvil.
	const button = document.querySelector('#menu-button');
	const menu = document.querySelector('#mobile-menu');
	const nav = document.querySelector('nav');

	// Selecciona todos los enlaces del menú móvil.
	const mobileLinks = document.querySelectorAll('#mobile-menu a');

	/*
	 * Alterna la visibilidad del menú móvil.
	 * Cuando el usuario hace clic en el botón "Menú":
	 * - Si el menú está oculto, lo muestra.
	 * - Si el menú está visible, lo oculta.
	 */
	button?.addEventListener('click', () => {
		menu?.classList.toggle('hidden');
		menu?.classList.toggle('flex');
	});

	/*
	 * Cierra automáticamente el menú cuando el usuario selecciona una opción de navegación.
	 * Esto permite que después de navegar a una sección del portafolio el menú vuelva a su estado inicial.
	 */
	mobileLinks.forEach((link) => {
		link.addEventListener('click', () => {
			menu?.classList.add('hidden');
			menu?.classList.remove('flex');
		});
	});

	/*
	 * Cierra el menú cuando el usuario hace clic fuera del área de navegación.
	 * Mejora la experiencia en dispositivos móviles, evitando que el menú permanezca abierto cuando el usuario toca otra zona de la pantalla.
	 */
	document.addEventListener('click', (event) => {
		const target = event.target as Node;

		if (!nav?.contains(target)) {
			menu?.classList.add('hidden');
			menu?.classList.remove('flex');
		}
	});
</script>
