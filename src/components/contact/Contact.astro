---
// Iconos.
import LinkedInIcon from '../../assets/icons/LinkedIn.astro';
import MailIcon from '../../assets/icons/Mail.astro';

// Componentes.
import Button from '../../assets/buttons/Button.astro';

// Constantes.
import {CONTACT} from '../../constants';

/*
 * Componente encargado de presentar la sección de contacto.
 * Ofrece el correo electrónico y LinkedIn como canales de contacto
 * para oportunidades laborales y de negocio.
 */

const emailUrl = `mailto:${CONTACT.email}`;

/*
 * Estilos del párrafo de invitación al contacto.
 */
const descriptionClass = `
	max-w-5xl
	text-foreground
	leading-8
`;

/*
 * Contenedor de los botones de contacto.
 */
const actionsClass = `
	flex
	flex-wrap
	gap-4
`;
---

<article class="flex flex-col gap-8">
	<p class={descriptionClass}>
		Escríbame por correo o conectemos en LinkedIn para conversar sobre cómo
		puedo ayudarle.
	</p>

	<div class={actionsClass}>
		<Button href={emailUrl} variant="email">
			<MailIcon class="size-5" />
			Correo electrónico
		</Button>

		<Button
			href={CONTACT.linkedIn}
			target="_blank"
			rel="noopener noreferrer"
			variant="linkedin">
			<LinkedInIcon class="size-5" />
			LinkedIn
		</Button>
	</div>
</article>
