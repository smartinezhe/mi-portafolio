---
/*
 * Componente que muestra una tecnología como elemento de lista, dentro de una
 * cápsula cuyo borde toma el color de la tecnología.
 */
interface Props {
	name: string;
	color: string;
}

const {name, color}: Props = Astro.props;

const techIconClass = `
	inline-flex
	items-center
	rounded-xl
	border-2
	bg-gray-950
	px-3
	py-1.5
	text-base
	text-foreground-muted
`;
---

<li class={techIconClass} style={`border-color: ${color};`}>
	{name}
</li>
