---
// Componentes.
import TechIcon from './TechIcon.astro';

// Datos.
import {STACK_GROUPS} from '../../techs';

/*
 * Componente que muestra la descripción profesional y stack de tecnologías agrupado por categoría.
 */

const descriptionClass = `
	text-foreground
	leading-8
`;

const groupTitleClass = `
	text-sm
	font-medium
	uppercase
	tracking-wider
	text-foreground-muted
`;

const techListClass = `
	flex
	flex-wrap
	gap-3
`;
---

<article class="flex flex-col gap-8">
	<p class={descriptionClass}>
		Soy Salem José Martínez Herrera, Ingeniero de Sistemas y Desarrollador Web
		enfocado en la creación de aplicaciones web. Convierto los procesos manuales
		de una empresa en sistemas centralizados, participando en todo el ciclo de
		desarrollo: desde el análisis de requisitos y el diseño de interfaces hasta
		la implementación de la lógica de negocio, la gestión de bases de datos, la
		puesta en producción y mantenimiento del aplicativo.
	</p>

	<div class="grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-6 lg:gap-10">
		{
			STACK_GROUPS.map((group) => (
				<div class="flex flex-col gap-3">
					<h3 class={groupTitleClass}>{group.title}</h3>
					<ul class={techListClass} role="list">
						{group.techs.map((tech) => (
							<TechIcon name={tech.name} color={tech.color} />
						))}
					</ul>
				</div>
			))
		}
	</div>
</article>
