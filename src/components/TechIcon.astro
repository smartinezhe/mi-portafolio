---
const {icon: Icon, name, color} = Astro.props;
---

<div
	class="inline-flex items-center gap-4 rounded-full border border-white/20 bg-gray-950 px-6 py-3 text-lg transition-all duration-200 ease-out hover:scale-105">
	<Icon style={`color: ${color}`} class="size-8" />

	<span class="text-gray-200 opacity-90">
		{name}
	</span>
</div>
