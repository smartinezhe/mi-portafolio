---
// Componentes.
import ProjectCard from './ProjectCard.astro';

// Datos y tipos.
import {TECHS} from '../../techs';
import type {Tech} from '../../types';
import type {ImageMetadata} from 'astro';

// Imágenes.
import Proyecto1 from '../../assets/img-projects/proyecto1.webp';

/*
 * Lista de proyectos del portafolio. Las tecnologías se toman del
 * catálogo central (`techs.ts`).
 */
interface Project {
	title: string;
	description: string;
	github?: string;
	image: ImageMetadata;
	imageAlt: string;
	tags: Tech[];
}

const projects: Project[] = [
	{
		title: 'Sistema de Gestión de Incapacidades Laborales',
		description:
			'Plataforma web que simplifica la gestión de incapacidades laborales, automatizando los procesos administrativos del área de recursos humanos para que las empresas ahorren tiempo y reduzcan errores.',
		github: 'https://github.com/smartinezhe/sistema-incapacidades',
		image: Proyecto1,
		imageAlt: 'Sistema de Gestión de Incapacidades Laborales',
		tags: [TECHS.LARAVEL, TECHS.FILAMENT, TECHS.TAILWIND, TECHS.MYSQL],
	},
];
---

<div class="flex flex-col gap-16">
	{projects.map((project) => <ProjectCard {...project} />)}
</div>
