---
/*
 * Componente encargado de renderizar una etiqueta que representa
 * una tecnología utilizada en un proyecto.
 */

/*
 * Propiedades necesarias para renderizar una etiqueta de tecnología.
 */
interface Props {
	name: string;
	color: string;
}

/*
 * Obtiene las propiedades necesarias para renderizar la etiqueta.
 */
const {name, color}: Props = Astro.props;

/*
 * Estilos principales de la etiqueta.
 * El color del borde se define con el color de la tecnología
 * mediante el atributo `style`.
 */
const tagClass = `
	flex
	items-center
	rounded-lg
	border
	bg-gray-950
	px-2
	py-1
	text-xs
	text-foreground-muted
`;
---

<li>
	<span class={tagClass} style={`border-color: ${color};`}>
		{name}
	</span>
</li>
